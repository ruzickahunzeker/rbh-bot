  "acceptance_mapping": [
    {"test": "TestA3PrivateBundleConstructionAndCopies", "covers": ["zero-action constructor", "typed-nil dependencies", "invalid/wallet mismatch", "copied expected profile", "shared health pointer"]},
    {"test": "TestA3BoundedSigningTwoCommitsAndHistoryReopen", "covers": ["one fixture signature and exact original artifact/nonce", "two healthy clock commits", "actual close/reopen", "history under stop/revoke no new signing"]},
    {"test": "TestA3BundleVerifierIsDecryptOnlyAndFresh", "covers": ["original verifier authenticates bundle artifact", "two fresh observations", "no extra economic or signing action"]},
    {"test": "TestA3TrustGateDenialsAndNanosecondBounds", "covers": ["stop priority", "auth/owner/epoch/identity/provider faults", "missing clock", "reversal floor", "lower causality", "upper expiry -1ns/equality/+1ns"]},
    {"test": "TestA3ClockFaultRollbackReleaseLatchNoResign", "covers": ["six marker/sign fault windows", "one-connection pool reacquisition before latch", "retained intent/floor", "actual reopen no resign"]},
    {"test": "TestA3HealthyClockWitnessAndCommitFaultsAtomic", "covers": ["both transactions audit and outbox failures", "real deferred FK COMMIT failures", "no half intent/artifact/healthy clock", "retained marker no resign"]},
    {"test": "TestA3GenerationGapAndPolicyDenialNotClockFault", "covers": ["concurrent healthy generation advance", "stop/revoke/takeover before final writer", "cancellation", "controlled pre-final-BEGIN error", "no false clock fault"]},
    {"test": "TestA3FailedLatchAndConcurrentAlreadyLatched", "covers": ["latch audit failure", "injected release-cleanup failure", "two-handle fault race one complete fault with exact witnesses"]},
    {"test": "TestA3PositiveUncertaintyAndStickyBundleFailure", "covers": ["positive nonzero uncertainty with advancing samples", "health flag shared across copies", "unhealthy action path does not sample"]},
    {"test": "TestA3PrivateGraphAndRecoveryIsolation", "covers": ["exact owner reference restrictions", "no action/send/startup/recovery bundle escape", "no goroutine", "narrow verifier dependency fields"]},
    {"test": "TestA3FinalWriterBarrierAndTwoHandleSigning", "covers": ["control writer actually attempts and returns SQLITE_BUSY while final fence held", "control mutation succeeds after COMMIT", "duplicate history may return without blocking", "one signer invocation across handles"]},
    {"test": "TestA3RuntimeObservationAndIdentityDriftBeforeSign", "covers": ["wrong chain/profile/environment/code/digest/anchor", "unavailable observer", "identity drift before/after signer", "tick/session changes"]},
    {"test": "TestA3ActualProcessClockCrashWindows", "covers": ["real child exit77 marker committed", "exit after detection before latch", "exit after latch", "actual reopen retained marker/floor/fault", "no automatic signer invocation"], "not_power_loss_proof": true},
    {"test": "TestA3SignerCipherFailureRetainsOriginalMarker", "covers": ["error/panic/wrong nonce/timeout/cipher failure", "one original fixture invocation", "no artifact", "duplicate never resigns"]},
    {"test": "TestA3DatabaseUnavailableDuringFaultPersistence", "covers": ["actual DB close after release", "combined errors and unhealthy action bundle", "no durable latch on actual reopen", "original marker retained"]},
    {"test": "TestA3FinalClockSampleAfterArtifactAuthentication", "covers": ["decryptor advances time to expiry", "post-crypto resample rejects artifact COMMIT", "one original signature ambiguity retained"]},
    {"test": "TestA3ProfileFreshnessNanosecondBounds", "covers": ["A3 profile maxAge nonce/runtime wall and monotonic -1ns/equality/+1ns", "zero and positive uncertainty", "no signer or durable mutation"]},
    {"test": "TestA3ProfileFreshnessWriterBoundariesNoResign", "covers": ["strict equality rejection before signer", "post-signer final rejection rolls back artifact", "marker retained and duplicate/reopen do not resign"]}
