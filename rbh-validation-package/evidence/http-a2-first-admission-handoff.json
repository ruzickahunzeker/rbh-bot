      "durable_admission_retained": true,
      "saved_witness_copy_usable_after_failure": false
    },
    {
      "test": "TestA2DifferentIntakeAdmissionWinnersTwoHandles",
      "covers": ["two independent SQLite handles", "deterministic barrier outside writer", "duplicate intake is sole fresh admission owner", "intake winner later gets history only", "historical loser does not mutate durable state"]
