{
  "status": "CANDIDATE_DESIGN_NOT_IMPLEMENTED",
  "transport": "HTTP over Unix Domain Socket",
  "stream_encoding": "NDJSON",
  "delivery": "at-least-once after durable producer commit",
  "ordering": "per producer durable offset, not cross-provider total order",
  "endpoints": [
    {
      "owner": "feed_service",
      "method": "GET",
      "path": "/internal/events",
