# E1 evm-bot: only the existing Robinhood runtime can start.
# Legacy RBH_* / ROBINHOOD_RPC_URL aliases remain supported; see docs/EVM_CONFIG.md.
# Both forms must be byte-identical if configured together, otherwise startup fails.
EVM_DATA_DIR=./data
EVM_SOCKET_DIR=./data/run
EVM_LOG_LEVEL=INFO
EVM_CHAIN_ID=4663
EVM_LIVE_ENABLED=false
EVM_CONTROLLED_CANARY_PRODUCTION_MODE=DISABLED
# Inject at least 32 random bytes for existing authenticated internal IPC.
EVM_INTERNAL_AUTH_SECRET=
# No automatic endpoint; configure only the separately approved chain RPC.
EVM_RPC_URL=
EVM_DRY_RUN_WALLET_ID=
EVM_DRY_RUN_FROM_ADDRESS=
# Existing pre-broadcast signer/artifact secrets: inject at runtime, never persist here.
EVM_EXECUTION_PRIVATE_KEY=
EVM_ARTIFACT_ENCRYPTION_KEY=
EVM_ARTIFACT_KEY_VERSION=v1
# BSC/Base startup, production broadcast, real canary and live remain unavailable.
