RBH_DATA_DIR=./data
RBH_SOCKET_DIR=./data/run
RBH_LOG_LEVEL=INFO
RBH_CHAIN_ID=4663
RBH_LIVE_ENABLED=false
# Required before business IPC endpoints are enabled. Generate at least 32 random bytes.
RBH_INTERNAL_AUTH_SECRET=
# Required only by trade-service PR-004 dry-run. This is an address-only identity; never a key.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RBH_DRY_RUN_WALLET_ID=
RBH_DRY_RUN_FROM_ADDRESS=
# PR-005 pre-broadcast only. Secrets are injected at runtime and never persisted.
RBH_EXECUTION_PRIVATE_KEY=
RBH_ARTIFACT_ENCRYPTION_KEY=
RBH_ARTIFACT_KEY_VERSION=v1
