RBH_DATA_DIR=./data
RBH_SOCKET_DIR=./data/run
RBH_LOG_LEVEL=INFO
RBH_CHAIN_ID=4663
RBH_LIVE_ENABLED=false
# Required before business IPC endpoints are enabled. Generate at least 32 random bytes.
RBH_INTERNAL_AUTH_SECRET=
# Required only by trade-service PR-004 dry-run. This is an address-only identity; never a key.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RBH_DRY_RUN_WALLET_ID=
RBH_DRY_RUN_FROM_ADDRESS=
# PR-005 pre-broadcast only. Secrets are injected at runtime and never persisted.
RBH_EXECUTION_PRIVATE_KEY=
RBH_ARTIFACT_ENCRYPTION_KEY=
RBH_ARTIFACT_KEY_VERSION=v1
# Optional user HTTP contract on trade-service UDS. Empty leaves /v1 disabled.
# Private regular JSON file (0600/0400); distinct scoped Bearer credential.
# This API cannot enable live or queue submissions; intake defaults off.
RBH_TRADE_API_CONFIG_FILE=
# Optional fixed read-only RPC queries for /v1. Does not enable execution/send.
# Uses ROBINHOOD_RPC_URL; startup performs no new query network I/O.
RBH_TRADE_API_READ_QUERIES=false
# Records MANUAL validation-pending orders only; NO execution/signing/sending.
RBH_TRADE_API_MANUAL_INTAKE=false
# Optional internal quote/simulation ONLY; no signing, nonce or send.
# Requires manual intake, private API config and an EXISTING immutable C07 policy.
RBH_TRADE_API_VALIDATE_ORDERS=false
RBH_TRADE_API_VALIDATION_POLICY_VERSION=0
