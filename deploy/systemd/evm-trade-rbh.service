[Unit]
Description=evm-bot Trade Service (Robinhood Chain 4663)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/evm-bot
EnvironmentFile=/root/evm-bot/data/env/trade-rbh.env
ExecStart=/root/evm-bot/bin/trade-service
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
