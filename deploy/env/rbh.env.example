# RBH service-local configuration. Copy privately and replace endpoints/secrets.
# feed-service loads data/env/feed-rbh.env; trade-service loads trade-rbh.env.
RBH_CHAIN_ID=4663
RBH_CHAIN_SLUG=rbh
RBH_DATA_DIR=/root/evm-bot/data/rbh
RBH_SOCKET_DIR=/root/evm-bot/data/rbh/run
RBH_LOG_LEVEL=INFO
RBH_LIVE_ENABLED=false
RBH_RPC_URL=https://REPLACE_WITH_AUTHORIZED_RPC
RBH_WS_URL=wss://REPLACE_WITH_AUTHORIZED_RPC
RBH_INTERNAL_AUTH_SECRET=
RBH_ARTIFACT_ENCRYPTION_KEY=
RBH_ARTIFACT_KEY_VERSION=v1

# feed-service only: standard JSON-RPC WS, not Nitro sequencer frames.
RBH_FEED_SOURCE=rpc_ws
RBH_FEED_START_MODE=latest
RBH_FEED_MAX_CATCHUP_BLOCKS=200
RBH_FEED_MAX_LAG_BLOCKS=8
RBH_FEED_GAP_POLICY=halt
RBH_FEED_REQUEST_INTERVAL=50ms

# trade-service only: retain existing private API configuration and policy.
RBH_TRADE_STARTUP_PROFILE=QUERY_AND_RECOVERY
RBH_TRADE_API_CONFIG_FILE=/root/evm-bot/data/env/trade-api-rbh.json
RBH_TRADE_API_READ_QUERIES=true
RBH_READONLY_QUERY_ONLY=true

# EVM_WALLET_PASSPHRASE / EVM_KEYSTORE_DIR remain global wallet settings.
# Never commit a populated private environment file.
